# Copy to .env. Docker Compose reads it automatically; for a local
# `npm start`, export these variables in your shell instead.

# Long random string used to sign session cookies (required in production).
SESSION_SECRET=replace-with-a-long-random-string

# Local MongoDB for `npm start`; Compose sets its own URI.
MONGODB_URI=mongodb://localhost:27017/eballot

# Host port for Compose / listen port for `npm start`.
PORT=3000

# Set to true when the app is served over HTTPS.
COOKIE_SECURE=false

# Set when running behind a reverse proxy (e.g. 1), so rate limiting sees client IPs.
# TRUST_PROXY=1
